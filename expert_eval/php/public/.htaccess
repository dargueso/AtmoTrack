# DANA expert evaluation site — https://meteorologia.uib.es/dana/
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/(.*)$ api.php?r=$1 [QSA,L]
</IfModule>

# Map frames never change; the page and scripts are revalidated so updates show up at once
<IfModule mod_headers.c>
    <FilesMatch "\.png$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
